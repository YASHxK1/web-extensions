{
  "manifest_version": 3,
  "name": "FloatTab",
  "version": "3.0.0",
  "description": "Open websites in compact interactive Firefox windows.",
  "permissions": ["activeTab", "storage", "tabs"],
  "background": {
    "scripts": [
      "shared/policy.js",
      "shared/runtime.js",
      "background/firefox_background.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "floattab@example.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
