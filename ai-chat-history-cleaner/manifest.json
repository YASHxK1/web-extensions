{
  "manifest_version": 3,
  "name": "Chat History Cleaner",
  "version": "1.2.0",
  "description": "Review and selectively delete ChatGPT or Claude conversations using a Keep-by-default side panel.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "action": {
    "default_title": "Review chat history"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
